SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
CRON_SECRET=your-cron-secret

# Required for webhook signature verification. Must match the secret configured
# in Razorpay Dashboard -> Settings -> Webhooks. Defaults to "dummy", which
# rejects every delivery — /health reports this as "unconfigured".
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Observability ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# "console" for local development, "json" in deployment
LOG_FORMAT=console
# Leave empty to disable error reporting
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
